{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/services-3", "destination": "/services", "permanent": true },
    { "source": "/about-3", "destination": "/about", "permanent": true },
    { "source": "/contact-4", "destination": "/contact", "permanent": true },
    { "source": "/book-online", "destination": "/contact", "permanent": true },
    { "source": "/quote", "destination": "/contact", "permanent": true },
    { "source": "/general-4", "destination": "/financing", "permanent": true },
    { "source": "/payments", "destination": "/financing", "permanent": true },
    { "source": "/process", "destination": "/approach", "permanent": true },
    { "source": "/privacy-policy", "destination": "/privacy", "permanent": true },
    { "source": "/cookie-policy", "destination": "/cookies", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!assets/|media/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "cache-control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        { "key": "cache-control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
